{
  "name": "alt-t",
  "productName": "Alt-T",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "yeahyeahyeahyeahyeah0520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeahyeahyeahyeahyeah0520/Alt-T.git"
  },
  "bugs": {
    "url": "https://github.com/yeahyeahyeahyeahyeah0520/Alt-T/issues"
  },
  "homepage": "https://github.com/yeahyeahyeahyeahyeah0520/Alt-T#readme",
  "description": "Pure, lightweight floating prompt translator & one-key Enter-to-Terminal injector for AI coding CLIs (Claude Code, Codex, Antigravity, Terminal)",
  "keywords": [
    "alt-t",
    "prompt-translator",
    "terminal",
    "cli",
    "claude-code",
    "codex",
    "windows-terminal",
    "electron",
    "koffi"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "check": "node scripts/check-rules.mjs",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "smoke": "node scripts/smoke-launch.mjs",
    "verify": "npm run typecheck && npm run check && npm test && electron-vite build && npm run smoke",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "koffi": "2.16.4",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "build": {
    "appId": "com.alt-t.app",
    "productName": "Alt-T",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/koffi/{doc,lib,src,vendor}/**/*",
      "!node_modules/koffi/{CHANGELOG.md,README.md,index.d.ts}",
      "!node_modules/**/*.{d.ts,map}"
    ],
    "afterPack": "./scripts/after-pack.mjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Alt-T",
      "artifactName": "Alt-T-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Alt-T-${version}-portable.${ext}"
    }
  }
}
